// Requires the "Oxc" Zed extension (command palette -> "zed: extensions" -> search "Oxc").
// `binary` points at this project's node_modules, overriding the global settings
// which reference non-existent global oxfmt/oxlint binaries.
{
  "lsp": {
    "oxlint": {
      "binary": {
        "path": "/Users/kelvinmodesto/.nvm/versions/node/v22.23.3/bin/node",
        "arguments": [
          "/Users/kelvinmodesto/Projects/unipds/engenharia-de-software-com-ia-aplicada/modulo01-fundamentos-de-ia-e-llms-para-programadores/exemplo-00/node_modules/oxlint/bin/oxlint",
          "--lsp",
        ],
      },
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix"
        }
      }
    },
    "oxfmt": {
      "binary": {
        "path": "/Users/kelvinmodesto/.nvm/versions/node/v22.23.3/bin/node",
        "arguments": [
          "/Users/kelvinmodesto/Projects/unipds/engenharia-de-software-com-ia-aplicada/modulo01-fundamentos-de-ia-e-llms-para-programadores/exemplo-00/node_modules/oxfmt/bin/oxfmt",
          "--lsp",
        ],
      },
      "initialization_options": {
        "settings": {
          "run": "onSave"
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "language_servers": ["oxlint", "oxfmt", "!eslint", "..."],
      "formatter": [
        // Apply safe oxlint fixes first, then format so the final output matches oxfmt.
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": { "allowed": false },
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  }
}
